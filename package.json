{
  "name": "qq-bot-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for QQ Guild Bot — 腾讯 QQ 频道机器人 SDK（基于 Node.js 24 原生 API）",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "example:basic": "node --experimental-strip-types examples/basic.ts",
    "example:file": "node --experimental-strip-types examples/send-file.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "qq",
    "bot",
    "sdk",
    "guild",
    "typescript",
    "qq-bot",
    "qqbot",
    "node24"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "^5.8.0"
  },
  "type": "module"
}
